    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@5.0.7": "5.0.9",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.0"
