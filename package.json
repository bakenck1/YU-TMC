{
  "name": "my-next-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "start": "next start",
    "lint": "eslint",
    "test:all": "node scripts/test-all.mjs",
    "test:components": "tsc --project tests/typecheck/tsconfig.components.json --pretty false && vitest run --config vitest.components.config.mts",
    "ui:check": "node scripts/check-ui-architecture.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "legacy:check": "node scripts/check-legacy-compatibility.mjs",
    "artifacts:check": "node scripts/check-repository-artifacts.mjs",
    "test:database:local": "node scripts/test-database-local.mjs",
    "security:check": "node scripts/security-check.mjs",
    "monitor:prod-errors": "node scripts/monitor-production-errors.mjs --since-minutes 30",
    "worker:tmc-push": "node --conditions=react-server --import tsx scripts/process-tmc-push-outbox.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:import-auth": "node --conditions=react-server --import tsx scripts/db/import-legacy-auth.ts",
    "db:import-settings": "node --conditions=react-server --import tsx scripts/db/import-settings.ts",
    "db:smoke": "tsx scripts/db/smoke.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/db/seed.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:reset-users": "tsx scripts/db/reset-users.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  },
  "overrides": {
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@5.0.7": "5.0.9",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.0"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
