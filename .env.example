# Legacy import source only. Runtime login reads PostgreSQL after
# `npm run db:import-auth -- --target=development`.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_NAME=System Administrator
AUTH_ADMIN_ROLE=admin
AUTH_ADMIN_BLOCKED=false
AUTH_ADMIN_PASSWORD_SALT=replace-with-a-random-salt
AUTH_ADMIN_PASSWORD_HASH=replace-with-a-128-character-scrypt-hex-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
# Public browser origin used for redirects and same-origin mutation checks.
# Keep the local value for development and replace it with the exact HTTPS
# origin used by the production ingress.
APP_PUBLIC_ORIGIN=http://localhost:3000
# Stable, non-secret release identifier included in structured events.
APP_DEPLOYMENT_ID=yu-inventory-local
# Keep false unless the approved ingress strips the client value and injects
# its own X-Request-Id. Direct client forwarding is never trusted by default.
TRUST_FORWARDED_REQUEST_ID=false
# One-time capability required to create the first administrator.
AUTH_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# The ingress must remove this client-supplied header and set it itself.
# Allowed: cf-connecting-ip, x-real-ip, x-forwarded-for.
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Bearer key protecting the real Dockflow endpoints under /api/v1.
DOCKFLOW_API_KEY=replace-with-a-random-production-api-key
# Optional overlap slot used while rotating the Dockflow key.
DOCKFLOW_API_KEY_NEXT=

# Read-only key limited to active buildings and rooms under /api/v1.
# Keep it different from DOCKFLOW_API_KEY so a facilities consumer cannot
# access employees, assignments, item costs, or photos.
FACILITIES_API_KEY=replace-with-a-random-production-api-key
# Optional overlap slot used while rotating the facilities key.
FACILITIES_API_KEY_NEXT=

# Read-only key for dormitory.yu.edu.kz. This key can only list assets whose
# current physical location is one of the maintained dormitory buildings.
DORMITORY_API_KEY=replace-with-a-random-production-api-key
# Optional overlap slot used while rotating the dormitory integration key.
DORMITORY_API_KEY_NEXT=
# Separate write key used only when the dormitory system creates a maintenance request.
DORMITORY_WRITE_API_KEY=replace-with-a-different-random-production-api-key
DORMITORY_WRITE_API_KEY_NEXT=

# Bearer key used by 1C when posting fixed-asset XML to the integration API.
# Keep this secret outside source control and use a different value per environment.
ONE_C_FIXED_ASSETS_API_KEY=replace-with-a-random-production-api-key

# Google Cloud OAuth 2.0 Web application. Register the exact redirect URI in
# Google Cloud and keep the client secret outside source control.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=yu.edu.kz

# Yessenov ID OpenID Connect application. Ask the identity team to register
# the exact callback URI and issue a confidential-client secret. Production
# must use the public HTTPS callback. Tokens are accepted only with RS256.
YESSENOV_OIDC_CLIENT_ID=replace-with-yessenov-oidc-client-id
YESSENOV_OIDC_CLIENT_SECRET=replace-with-at-least-24-random-characters
YESSENOV_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/yessenov/callback
# Service token issued by Yessenov University for GET /api/v2/personnels/.
# The server sends it as `Authorization: Token <token>` and never exposes it
# to Dockflow or to the browser.
YESSENOV_DIRECTORY_API_TOKEN=replace-with-yessenov-directory-service-token

# Optional server-only WhatsApp notifications for internal service requests.
# Ask the YU WA Gateway administrator for the token and session. With no token,
# WhatsApp checks and notifications are disabled.
WA_GATEWAY_URL=http://wa.yu.edu.kz
WA_API_TOKEN=
WA_SESSION=otinish

# Generate this key pair once with `npx web-push generate-vapid-keys --json`.
# Keep the private key only in the deployment secret store.
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:inventory-admin@yu.edu.kz

# The webhook must deliver the supplied code/resetUrl to the user's email.
AUTH_PASSWORD_RESET_WEBHOOK_URL=https://your-mail-service.example/reset
AUTH_PASSWORD_RESET_WEBHOOK_SECRET=replace-with-a-webhook-secret
AUTH_PASSWORD_RESET_PUBLIC_ORIGIN=http://localhost:3000

# Development database. Copy this file to .env.local for local work.
DATABASE_URL=postgresql://yu_inventory:local-development-password@127.0.0.1:5432/yu_inventory_dev
DATABASE_DEPLOYMENT_ID=yu-inventory-local-development
DATABASE_TARGET=development
# Development may use the same local role/endpoint for migrations. Production
# must use a different role and a direct or session-pooling endpoint.
DATABASE_MIGRATOR_URL=postgresql://yu_inventory:local-development-password@127.0.0.1:5432/yu_inventory_dev
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=60000

# Production values are injected by the deployment platform. Use a runtime role
# in DATABASE_URL and a separate schema-owner role in DATABASE_MIGRATOR_URL.
# Set DATABASE_DEPLOYMENT_ID to a stable logical identifier for that database.
# Verified TLS is the production default. Set DATABASE_SSL_CA to a private CA
# certificate only when the PostgreSQL provider requires it.
