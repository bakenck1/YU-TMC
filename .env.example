# Password login is disabled until all four required values are configured.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_NAME=System Administrator
AUTH_ADMIN_ROLE=admin
AUTH_ADMIN_BLOCKED=false
AUTH_ADMIN_PASSWORD_SALT=replace-with-a-random-salt
AUTH_ADMIN_PASSWORD_HASH=replace-with-a-128-character-scrypt-hex-hash
SESSION_SECRET=replace-with-at-least-32-random-characters

# The webhook must deliver the supplied code/resetUrl to the user's email.
AUTH_PASSWORD_RESET_WEBHOOK_URL=https://your-mail-service.example/reset
AUTH_PASSWORD_RESET_WEBHOOK_SECRET=replace-with-a-webhook-secret

# Development database. Copy this file to .env.local for local work.
DATABASE_URL=postgresql://yu_inventory:local-development-password@127.0.0.1:5432/yu_inventory_dev
DATABASE_DEPLOYMENT_ID=yu-inventory-local-development
# Development may use the same local role/endpoint for migrations. Production
# must use a different role and a direct or session-pooling endpoint.
DATABASE_MIGRATOR_URL=postgresql://yu_inventory:local-development-password@127.0.0.1:5432/yu_inventory_dev
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=60000

# Production values are injected by the deployment platform. Use a runtime role
# in DATABASE_URL and a separate schema-owner role in DATABASE_MIGRATOR_URL.
# Set DATABASE_DEPLOYMENT_ID to a stable logical identifier for that database.
# Verified TLS is the production default. Set DATABASE_SSL_CA to a private CA
# certificate only when the PostgreSQL provider requires it.
