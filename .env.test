# Shared, non-secret defaults for the dedicated local/CI test database.
# CI may override these values; developer-only overrides belong in .env.test.local.
TEST_DATABASE_URL=postgresql://yu_inventory_test:local-test-password@127.0.0.1:55433/yu_inventory_test
TEST_DATABASE_DEPLOYMENT_ID=yu-inventory-local-test
TEST_DATABASE_MIGRATOR_URL=postgresql://yu_inventory_test:local-test-password@127.0.0.1:55433/yu_inventory_test
TEST_DATABASE_SSL_MODE=disable
TEST_DATABASE_POOL_MAX=2
TEST_DATABASE_CONNECTION_TIMEOUT_MS=5000
TEST_DATABASE_IDLE_TIMEOUT_MS=30000
TEST_DATABASE_STATEMENT_TIMEOUT_MS=30000
TEST_DATABASE_MIGRATION_LOCK_TIMEOUT_MS=60000
